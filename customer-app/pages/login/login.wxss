/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #bc0bf6 0%, #d65eff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-box {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 80rpx 60rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 80rpx;
}

.btn-login {
  width: 100%;
  margin-bottom: 40rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.link {
  color: #bc0bf6;
}
