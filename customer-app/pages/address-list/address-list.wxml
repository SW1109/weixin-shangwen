<!--pages/address-list/address-list.wxml-->
<view class="container">
  <!-- 地址列表 -->
  <view wx:if="{{addresses.length > 0}}" class="address-list">
    <view 
      wx:for="{{addresses}}" 
      wx:key="_id"
      class="address-item {{item.isDefault ? 'default' : ''}}"
      bindtap="onSelectAddress"
      data-id="{{item._id}}"
    >
      <!-- 默认标签 -->
      <view wx:if="{{item.isDefault}}" class="default-tag">默认</view>
      
      <!-- 地址信息 -->
      <view class="address-info">
        <view class="address-header">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
        </view>
        <view class="address-detail">
          <text class="icon">📍</text>
          <text class="text">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="address-actions" catchtap="stopPropagation">
        <view 
          wx:if="{{!item.isDefault}}"
          class="action-btn" 
          bindtap="setDefaultAddress" 
          data-id="{{item._id}}"
        >
          <text class="btn-text">设为默认</text>
        </view>
        <view class="action-btn" bindtap="onEditAddress" data-id="{{item._id}}">
          <text class="btn-text">✏️ 编辑</text>
        </view>
        <view class="action-btn danger" bindtap="onDeleteAddress" data-id="{{item._id}}">
          <text class="btn-text">🗑️ 删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{addresses.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📍</text>
    <text class="empty-text">还没有收货地址</text>
    <text class="empty-hint">点击下方按钮添加地址</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 添加地址按钮 -->
  <view class="add-btn-wrapper">
    <button class="add-btn" bindtap="onAddAddress">
      <text>+ 添加新地址</text>
    </button>
  </view>
</view>
