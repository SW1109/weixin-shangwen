/* pages/address-list/address-list.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
}

.address-item {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.address-item.default {
  border: 2rpx solid #bc0bf6;
}

/* 默认标签 */
.default-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #bc0bf6;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 16rpx 0 16rpx;
}

/* 地址信息 */
.address-info {
  margin-bottom: 20rpx;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.address-header .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.address-header .phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.address-detail .icon {
  font-size: 32rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.address-detail .text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 操作按钮 */
.address-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background: #fff;
}

.action-btn .btn-text {
  font-size: 26rpx;
  color: #666;
}

.action-btn.danger .btn-text {
  color: #ff4444;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 添加按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #bc0bf6;
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  border: none;
  text-align: center;
  display:flex;
  align-items: center;
  justify-content: center;

}

.add-btn text {
  font-weight: bold;
}

.container {
  padding: 20rpx;
}
