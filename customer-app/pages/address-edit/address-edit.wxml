<!--pages/address-edit/address-edit.wxml-->
<view class="container">
  <form>
    <!-- 收货人信息 -->
    <view class="form-section">
      <view class="form-item">
        <text class="label">收货人</text>
        <input
          class="input"
          placeholder="请输入收货人姓名"
          value="{{formData.name}}"
          bindinput="onNameInput"
          maxlength="20"
        />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          value="{{formData.phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>
    </view>

    <!-- 所在地区 -->
    <view class="form-section">
      <view class="form-item">
        <text class="label">省份</text>
        <picker
          mode="selector"
          range="{{provinces}}"
          value="{{provinceIndex}}"
          bindchange="onProvinceChange"
        >
          <view class="picker">
            <text class="picker-text {{formData.province ? '' : 'placeholder'}}">
              {{formData.province || '请选择省份'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">城市</text>
        <picker
          mode="selector"
          range="{{cities[formData.province]}}"
          value="{{cityIndex}}"
          bindchange="onCityChange"
        >
          <view class="picker">
            <text class="picker-text {{formData.city ? '' : 'placeholder'}}">
              {{formData.city || '请选择城市'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">区域</text>
        <picker
          mode="selector"
          range="{{districts[formData.city]}}"
          value="{{districtIndex}}"
          bindchange="onDistrictChange"
        >
          <view class="picker">
            <text class="picker-text {{formData.district ? '' : 'placeholder'}}">
              {{formData.district || '请选择区域'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 详细地址 -->
    <view class="form-section">
      <view class="form-item column">
        <text class="label">详细地址</text>
        <textarea
          class="textarea"
          placeholder="请输入详细地址，如街道、门牌号等"
          value="{{formData.detail}}"
          bindinput="onDetailInput"
          maxlength="100"
          auto-height
        />
      </view>
    </view>

    <!-- 设为默认地址 -->
    <view class="form-section">
      <view class="form-item switch">
        <text class="label">设为默认地址</text>
        <switch
          checked="{{formData.isDefault}}"
          bindchange="onDefaultChange"
          color="#bc0bf6"
        />
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-btn-wrapper">
      <button class="save-btn" bindtap="onSave">保存</button>
    </view>
  </form>
</view>
