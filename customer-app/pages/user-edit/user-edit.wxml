<!--pages/user-edit/user-edit.wxml-->
<view class="container">
  <view class="avatar-section">
    <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill"></image>
      <view class="edit-icon">📷</view>
    </button>
    <text class="avatar-tip">点击修改头像</text>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="label">昵称</text>
      <input type="nickname" class="input" placeholder="请输入昵称" value="{{userInfo.nickName}}" bindchange="onNickNameChange" bindinput="onNickNameInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{userInfo.phoneNumber}}" bindinput="onPhoneInput" />
    </view>
  </view>

  <button class="btn-save btn-primary" bindtap="onSave" loading="{{saving}}">保存修改</button>
</view>
