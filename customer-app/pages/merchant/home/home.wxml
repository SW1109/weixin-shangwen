<!--pages/home/home.wxml-->
<wxs src="../../../utils/format.wxs" module="format" />
<view class="container">
  <!-- 今日统计卡片 -->
  <view class="stats-card">
    <view class="card-title">今日概览</view>
    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-value">¥{{format.toFixed(todayStats.salesAmount)}}</view>
        <view class="stats-label">销售额</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{todayStats.orderCount}}</view>
        <view class="stats-label">订单数</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{todayStats.dishCount}}</view>
        <view class="stats-label">菜品数</view>
      </view>
    </view>
  </view>

  <!-- 订单状态 -->
  <view class="order-status-card">
    <view class="card-title">订单状态</view>
    <view class="status-list">
      <view class="status-item" bindtap="onViewOrders" data-status="1">
        <view class="status-icon">💰</view>
        <view class="status-count">{{orderStats.unpaid}}</view>
        <view class="status-label">待支付</view>
      </view>
      <view class="status-item" bindtap="onViewOrders" data-status="2">
        <view class="status-icon">📦</view>
        <view class="status-count">{{orderStats.toDeliver}}</view>
        <view class="status-label">待配送</view>
      </view>
      <view class="status-item" bindtap="onViewOrders" data-status="3">
        <view class="status-icon">🚚</view>
        <view class="status-count">{{orderStats.delivering}}</view>
        <view class="status-label">配送中</view>
      </view>
      <view class="status-item" bindtap="onViewOrders">
        <view class="status-icon">📋</view>
        <view class="status-count">{{recentOrders.length}}</view>
        <view class="status-label">全部订单</view>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="function-card">
    <view class="card-title">常用功能</view>
    <view class="function-list">
      <view class="function-item" bindtap="onManageDishes">
        <view class="function-icon">🍽️</view>
        <view class="function-label">菜品管理</view>
      </view>
      <view class="function-item" bindtap="onStatistics">
        <view class="function-icon">📊</view>
        <view class="function-label">数据统计</view>
      </view>
      <view class="function-item" bindtap="onManageCategory">
        <view class="function-icon">🏷️</view>
        <view class="function-label">分类管理</view>
      </view>
    </view>
  </view>

  <!-- 热销菜品 -->
  <view wx:if="{{topDishes.length > 0}}" class="top-dishes-card">
    <view class="card-title">
      <text>热销菜品</text>
      <text class="more" bindtap="onManageDishes">管理菜品 ›</text>
    </view>
    <view class="dish-list">
      <view wx:for="{{topDishes}}" wx:key="_id" class="dish-item">
        <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-sales">销量: {{item.sales}}</view>
        </view>
        <view class="dish-price">¥{{item.price}}</view>
      </view>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="recent-orders-card">
    <view class="card-title">
      <text>最近订单</text>
      <text class="more" bindtap="onViewOrders">查看全部 ›</text>
    </view>
    <view wx:if="{{recentOrders.length > 0}}" class="order-list">
      <view wx:for="{{recentOrders}}" wx:key="_id" class="order-item" bindtap="onOrderDetail" data-id="{{item._id}}">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">
            {{item.status === 1 ? '待支付' : item.status === 2 ? '待配送' : item.status === 3 ? '配送中' : '已完成'}}
          </text>
        </view>
        <view class="order-info">
          <text class="order-amount">¥{{item.totalAmount}}</text>
          <text class="order-time">{{item.createTime}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <text>暂无订单</text>
    </view>
  </view>
</view>
