/* pages/dish-list/dish-list.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-top: 180rpx;
}

/* 顶部操作栏 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-add,
.btn-category {
  flex: 1;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-add {
  background: #bc0bf6;
  color: #fff;
}

.btn-category {
  background: #f0f0f0;
  color: #333;
}

/* 分类标签 */
.categories {
  position: fixed;
  top: 110rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  z-index: 99;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.category-tag {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 40rpx;
  white-space: nowrap;
}

.category-tag.active {
  background: #bc0bf6;
  color: #fff;
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx;
}

.dish-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.dish-image {
  width: 100%;
  height: 360rpx;
}

.dish-content {
  padding: 30rpx;
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.dish-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-on {
  background: #f6ffed;
  color: #52c41a;
}

.status-off {
  background: #fff1f0;
  color: #f5222d;
}

.dish-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #bc0bf6;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #bc0bf6;
}

.dish-info {
  display: flex;
  gap: 20rpx;
}

.info-item {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.dish-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  background: #fff;
}

.btn-toggle {
  color: #bc0bf6;
  border-right: 1rpx solid #f0f0f0;
}

.btn-delete {
  color: #f5222d;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-container {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
