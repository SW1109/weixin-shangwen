/* pages/order-list/order-list.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-top: 100rpx;
}

/* 标签栏 */
.tabs {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #e5e5e5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #bc0bf6;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #bc0bf6;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-1 {
  background: #fff7e6;
  color: #fa8c16;
}

.status-2 {
  background: #e6f7ff;
  color: #1890ff;
}

.status-3 {
  background: #f0f5ff;
  color: #597ef7;
}

.status-4 {
  background: #f6ffed;
  color: #52c41a;
}

.status-5 {
  background: #fff1f0;
  color: #f5222d;
}

.order-content {
  padding: 24rpx 30rpx;
}

/* 客户信息 */
.customer-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.customer-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.customer-phone {
  font-size: 26rpx;
  color: #666;
}

/* 菜品列表 */
.dishes {
  margin-bottom: 20rpx;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.dish-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.dish-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
}

.dish-price {
  font-size: 26rpx;
  color: #666;
}

/* 配送地址 */
.address {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #fff9f0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.address-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.address-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-amount {
  display: flex;
  align-items: baseline;
}

.amount-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
}

.amount-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #bc0bf6;
}

/* 操作按钮 */
.order-actions {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}

.action-tip {
  font-size: 26rpx;
  color: #999;
  text-align: right;
}

.action-btns {
  display: flex;
  gap: 20rpx;
}

.btn-action {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-primary {
  background: #bc0bf6;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-container {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
