<!--pages/order-list/order-list.wxml-->
<wxs src="../../../utils/format.wxs" module="format" />
<view class="container">
  <!-- 标签栏 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{activeTab === item.value ? 'active' : ''}}"
      bindtap="onTabChange"
      data-value="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view wx:if="{{orders.length > 0}}">
      <view wx:for="{{orders}}" wx:key="_id" class="order-card">
        <view class="order-header" bindtap="onOrderDetail" data-id="{{item._id}}">
          <view class="order-no">订单号: {{item.orderNo}}</view>
          <view class="order-status status-{{item.status}}">
            {{item.status === 1 ? '待支付' : item.status === 2 ? '待配送' : item.status === 3 ? '配送中' : item.status === 4 ? '已完成' : '已取消'}}
          </view>
        </view>

        <view class="order-content" bindtap="onOrderDetail" data-id="{{item._id}}">
          <!-- 客户信息 -->
          <view class="customer-info">
            <text class="customer-name">{{item.userInfo.nickName}}</text>
            <text class="customer-phone">{{item.userInfo.phoneNumber}}</text>
          </view>

          <!-- 菜品列表 -->
          <view class="dishes">
            <view wx:for="{{item.dishes}}" wx:key="dishId" wx:for-item="dish" class="dish-row">
              <image class="dish-image" src="{{dish.image}}" mode="aspectFill"></image>
              <view class="dish-info">
                <text class="dish-name">{{dish.name}}</text>
                <text class="dish-price">¥{{format.toFixed(dish.price)}} x{{dish.quantity}}</text>
              </view>
            </view>
          </view>

          <!-- 配送地址 -->
          <view class="address">
            <text class="address-icon">📍</text>
            <text class="address-text">{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail}}</text>
          </view>

          <!-- 订单金额 -->
          <view class="order-footer">
            <view class="order-time">{{item.createTime}}</view>
            <view class="order-amount">
              <text class="amount-label">合计:</text>
              <text class="amount-value">¥{{format.toFixed(item.totalAmount)}}</text>
            </view>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="order-actions">
          <view wx:if="{{item.status === 1}}" class="action-tip">等待客户支付</view>
          <view wx:if="{{item.status === 2}}" class="action-btns">
            <button class="btn-action btn-primary" bindtap="onStartDelivery" data-id="{{item._id}}">开始配送</button>
          </view>
          <view wx:if="{{item.status === 3}}" class="action-tip">配送中...</view>
          <view wx:if="{{item.status === 4}}" class="action-tip">已完成</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-container">
      <text>加载中...</text>
    </view>
  </view>
</view>
