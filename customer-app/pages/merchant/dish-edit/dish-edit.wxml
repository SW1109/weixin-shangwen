<!--pages/dish-edit/dish-edit.wxml-->
<view class="container">
  <view class="form">
    <!-- 图片上传 -->
    <view class="form-section">
      <view class="section-title">菜品图片 *</view>
      <view class="image-upload" bindtap="onUploadImage">
        <image wx:if="{{formData.image}}" class="uploaded-image" src="{{formData.image}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">+</text>
          <text class="upload-text">点击上传图片</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="label">菜品名称 *</text>
        <input 
          class="input" 
          placeholder="请输入菜品名称"
          value="{{formData.name}}"
          bindinput="onInputChange"
          data-field="name"
        />
      </view>

      <view class="form-item">
        <text class="label">菜品分类 *</text>
        <picker 
          mode="selector"
          range="{{categories}}"
          range-key="name"
          value="{{categoryIndex}}"
          bindchange="onCategoryChange"
        >
          <view class="picker">
            {{formData.categoryName || '请选择分类'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">菜品描述</text>
        <textarea 
          class="textarea" 
          placeholder="请输入菜品描述"
          value="{{formData.description}}"
          bindinput="onInputChange"
          data-field="description"
          maxlength="200"
        />
      </view>
    </view>

    <!-- 价格库存 -->
    <view class="form-section">
      <view class="section-title">价格库存</view>
      
      <view class="form-item">
        <text class="label">售价 * (元)</text>
        <input 
          class="input" 
          type="digit"
          placeholder="请输入售价"
          value="{{formData.price}}"
          bindinput="onInputChange"
          data-field="price"
        />
      </view>

      <view class="form-item">
        <text class="label">原价 (元)</text>
        <input 
          class="input" 
          type="digit"
          placeholder="选填，用于显示优惠"
          value="{{formData.originalPrice}}"
          bindinput="onInputChange"
          data-field="originalPrice"
        />
      </view>

      <view class="form-item">
        <text class="label">库存 * (-1为无限)</text>
        <input 
          class="input" 
          type="number"
          placeholder="请输入库存数量"
          value="{{formData.stock}}"
          bindinput="onInputChange"
          data-field="stock"
        />
      </view>

      <view class="form-item">
        <text class="label">排序 (数字越小越靠前)</text>
        <input 
          class="input" 
          type="number"
          placeholder="默认为0"
          value="{{formData.sort}}"
          bindinput="onInputChange"
          data-field="sort"
        />
      </view>
    </view>

    <!-- 标签 -->
    <view class="form-section">
      <view class="section-title">菜品标签</view>
      
      <view class="tags-container">
        <view wx:for="{{formData.tags}}" wx:key="*this" class="tag-item">
          <text>{{item}}</text>
          <text class="tag-remove" bindtap="onRemoveTag" data-index="{{index}}">×</text>
        </view>
      </view>

      <view class="tag-input-row">
        <input 
          class="tag-input" 
          placeholder="输入标签，如：辣、热销"
          value="{{tagInput}}"
          bindinput="onTagInput"
        />
        <button class="btn-add-tag" bindtap="onAddTag">添加</button>
      </view>
    </view>

    <!-- 设置 -->
    <view class="form-section">
      <view class="section-title">其他设置</view>
      
      <view class="form-item form-switch">
        <text class="label">推荐菜品</text>
        <switch 
          color="#bc0bf6"
          checked="{{formData.isRecommend}}"
          bindchange="onRecommendChange"
        />
      </view>

      <view class="form-item form-switch">
        <text class="label">立即上架</text>
        <switch 
          color="#bc0bf6"
          checked="{{formData.status === 1}}"
          bindchange="onStatusChange"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-container">
      <button class="btn-submit" bindtap="onSubmit">
        {{isEdit ? '保存修改' : '添加菜品'}}
      </button>
    </view>
  </view>
</view>
