/* pages/statistics/statistics.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 日期范围 */
.date-range {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
}

.range-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}

.range-item.active {
  background: #bc0bf6;
  color: #fff;
  font-weight: bold;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stats-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #bc0bf6;
  margin-bottom: 12rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #999;
}

/* 区块卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 菜品排行 */
.dish-ranking {
  display: flex;
  flex-direction: column;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  background: #f0f0f0;
  color: #999;
  border-radius: 50%;
  margin-right: 20rpx;
}

.rank-1 {
  background: linear-gradient(135deg, #ffd700, #ffed4e);
  color: #fff;
}

.rank-2 {
  background: linear-gradient(135deg, #c0c0c0, #e8e8e8);
  color: #fff;
}

.rank-3 {
  background: linear-gradient(135deg, #cd7f32, #daa520);
  color: #fff;
}

.dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-sales {
  font-size: 24rpx;
  color: #999;
}

.dish-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #bc0bf6;
  margin-bottom: 4rpx;
}

.amount-label {
  font-size: 22rpx;
  color: #999;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 趋势图占位 */
.trend-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.trend-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.trend-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.trend-desc {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #999;
  font-size: 28rpx;
  z-index: 1000;
}
