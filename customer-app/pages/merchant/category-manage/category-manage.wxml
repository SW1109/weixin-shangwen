<!--pages/category-manage/category-manage.wxml-->
<view class="container">
  <!-- 添加按钮 -->
  <view class="header">
    <button class="btn-add" bindtap="onShowAdd">+ 添加分类</button>
  </view>

  <!-- 分类列表 -->
  <view class="category-list">
    <view wx:if="{{categories.length > 0}}">
      <view wx:for="{{categories}}" wx:key="_id" class="category-item">
        <view class="category-info">
          <view class="category-header">
            <text class="category-name">{{item.name}}</text>
            <view class="category-status {{item.status === 1 ? 'status-on' : 'status-off'}}">
              {{item.status === 1 ? '启用' : '禁用'}}
            </view>
          </view>
          <text class="category-sort">排序: {{item.sort}}</text>
        </view>
        
        <view class="category-actions">
          <button class="action-btn btn-edit" bindtap="onShowEdit" data-item="{{item}}">编辑</button>
          <button class="action-btn btn-delete" bindtap="onDelete" data-item="{{item}}">删除</button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <text class="empty-icon">📁</text>
      <text class="empty-text">暂无分类，点击上方添加吧</text>
    </view>
  </view>

  <!-- 添加/编辑对话框 -->
  <view wx:if="{{showAddDialog}}" class="dialog-mask" bindtap="onHideDialog">
    <view class="dialog-container" catchtap>
      <view class="dialog-title">{{editingCategory ? '编辑分类' : '添加分类'}}</view>
      
      <view class="dialog-content">
        <view class="dialog-item">
          <text class="dialog-label">分类名称 *</text>
          <input 
            class="dialog-input" 
            placeholder="请输入分类名称"
            value="{{formData.name}}"
            bindinput="onInputChange"
            data-field="name"
          />
        </view>

        <view class="dialog-item">
          <text class="dialog-label">排序 (数字越小越靠前)</text>
          <input 
            class="dialog-input" 
            type="number"
            placeholder="默认为0"
            value="{{formData.sort}}"
            bindinput="onInputChange"
            data-field="sort"
          />
        </view>

        <view class="dialog-item dialog-switch">
          <text class="dialog-label">启用状态</text>
          <switch 
            color="#bc0bf6"
            checked="{{formData.status === 1}}"
            bindchange="onStatusChange"
          />
        </view>
      </view>

      <view class="dialog-actions">
        <button class="dialog-btn btn-cancel" bindtap="onHideDialog">取消</button>
        <button class="dialog-btn btn-confirm" bindtap="onSave">保存</button>
      </view>
    </view>
  </view>
</view>
