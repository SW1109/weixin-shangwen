<!--pages/index/index.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <icon type="search" size="16" color="#999"></icon>
      <input type="text" placeholder="搜索菜品" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    </view>
  </view>

  <!-- 分类和菜品 -->
  <view class="content">
    <!-- 左侧分类 -->
    <scroll-view class="category-list" scroll-y>
      <view 
        class="category-item {{selectedCategory === null ? 'active' : ''}}"
        bindtap="onSelectCategory"
        data-id="{{null}}"
      >
        <text>全部</text>
      </view>
      <view 
        wx:for="{{categories}}" 
        wx:key="_id"
        class="category-item {{selectedCategory === item._id ? 'active' : ''}}"
        bindtap="onSelectCategory"
        data-id="{{item._id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-list" scroll-y bindscrolltolower="onLoadMore">
      <view wx:if="{{dishes.length > 0}}">
        <view 
          wx:for="{{dishes}}" 
          wx:key="_id"
          class="dish-item"
        >
          <image class="dish-image" src="{{item.image}}" mode="aspectFill" bindtap="onDishDetail" data-id="{{item._id}}"></image>
          <view class="dish-info" bindtap="onDishDetail" data-id="{{item._id}}">
            <view class="dish-name">{{item.name}}</view>
            <view class="dish-desc">{{item.description}}</view>
            <view class="dish-tags">
              <text wx:if="{{item.isRecommend}}" class="tag tag-hot">推荐</text>
              <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
            </view>
            <view class="dish-footer">
              <view class="price">
                <text class="price-symbol">¥</text>
                <text class="price-integer">{{item.price}}</text>
              </view>
              <view class="dish-actions" catchtap="stopPropagation">
                <view wx:if="{{getCartQuantity(item._id) > 0}}" class="quantity-control">
                  <view class="btn-minus" bindtap="onRemoveFromCart" data-id="{{item._id}}">
                    <text>-</text>
                  </view>
                  <text class="quantity">{{getCartQuantity(item._id)}}</text>
                  <view class="btn-plus" bindtap="onAddToCart" data-item="{{item}}">
                    <text>+</text>
                  </view>
                </view>
                <view wx:else class="btn-add" bindtap="onAddToCart" data-item="{{item}}">
                  <text>加入购物车</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view wx:if="{{dishes.length === 0 && !loading}}" class="empty-state">
        <text class="empty-text">暂无菜品</text>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{loading}}" class="loading-container">
        <text>加载中...</text>
      </view>
    </scroll-view>
  </view>

  <!-- 购物车按钮 -->
  <view class="cart-button" bindtap="onGoToCart">
    <view class="cart-icon">
      <icon type="success" size="28" color="#fff"></icon>
      <view wx:if="{{cartCount > 0}}" class="badge">{{cartCount}}</view>
    </view>
    <view class="cart-info">
      <view class="cart-total">¥{{cartTotal}}</view>
      <view class="cart-count">共{{cartCount}}件</view>
    </view>
    <view class="cart-checkout">
      <text>去结算</text>
    </view>
  </view>
</view>
