/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-input icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  min-width: 0;
}

/* 内容区域 */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
  padding-bottom: 136rpx;
}

/* 左侧分类 */
.category-list {
  width: 180rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
  height: 100%;
  box-sizing: border-box;
}

.category-item {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  position: relative;
  word-wrap: break-word;
  word-break: break-all;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.category-item.active {
  background-color: #fff;
  color: #bc0bf6;
  font-weight: bold;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background-color: #bc0bf6;
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧菜品列表 */
.dish-list {
  flex: 1;
  background-color: #fff;
  padding: 20rpx;
  height: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.dish-item {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.dish-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.dish-tags {
  margin-bottom: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  color: #999;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.tag-hot {
  background-color: #f8e6ff;
  color: #bc0bf6;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  color: #bc0bf6;
  font-weight: bold;
}

.price-integer {
  font-size: 36rpx;
  color: #bc0bf6;
  font-weight: bold;
}

.dish-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.btn-add {
  background-color: #bc0bf6;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.btn-minus,
.btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #bc0bf6;
  color: #fff;
  font-size: 32rpx;
}

.btn-minus {
  background-color: #f5f5f5;
  color: #666;
}

.quantity {
  margin: 0 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  min-width: 40rpx;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 购物车按钮 */
.cart-button {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #333;
  padding: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  box-sizing: border-box;
}

.cart-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  background-color: #bc0bf6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  background-color: #FF4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 18rpx;
  text-align: center;
  box-sizing: border-box;
}

.cart-info {
  flex: 1;
  color: #fff;
  min-width: 0;
}

.cart-total {
  font-size: 36rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-count {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 4rpx;
}

.cart-checkout {
  background-color: #bc0bf6;
  color: #fff;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
}
