<!--pages/order-confirm/order-confirm.wxml-->
<view class="container">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="onSelectAddress">
    <view wx:if="{{address}}" class="address-info">
      <view class="address-header">
        <text class="name">{{address.name}}</text>
        <text class="phone">{{address.phone}}</text>
      </view>
      <view class="address-detail">
        <text class="icon">📍</text>
        <text class="text">{{address.province}} {{address.city}} {{address.district}} {{address.detail}}</text>
      </view>
    </view>
    <view wx:else class="address-empty">
      <text class="icon">📍</text>
      <text class="text">请选择收货地址</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="dishes-section">
    <view class="section-title">菜品清单</view>
    <view class="dish-item" wx:for="{{cart}}" wx:key="_id">
      <image class="dish-image" src="{{item.image}}" mode="aspectFill" />
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-bottom">
          <view class="price">¥{{item.price}}</view>
          <view class="quantity">x{{item.quantity}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-section">
    <view class="section-title">订单备注</view>
    <textarea 
      class="remark-input" 
      placeholder="如有特殊要求请在此填写（选填）"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
    />
  </view>

  <!-- 金额明细 -->
  <view class="amount-section">
    <view class="amount-item">
      <text class="label">菜品总额</text>
      <text class="value">¥{{totalPrice}}</text>
    </view>
    <view class="amount-item">
      <text class="label">配送费</text>
      <text class="value">¥0.00</text>
    </view>
    <view class="amount-divider"></view>
    <view class="amount-item total">
      <text class="label">实付金额</text>
      <text class="value">¥{{totalPrice}}</text>
    </view>
  </view>

  <!-- 占位空间 -->
  <view style="height: 120rpx;"></view>
</view>

<!-- 底部提交按钮 -->
<view class="bottom-bar">
  <view class="total-info">
    <text class="label">合计：</text>
    <text class="price">¥{{totalPrice}}</text>
  </view>
  <button 
    class="submit-btn" 
    bindtap="onSubmit"
    disabled="{{submitting || cart.length === 0}}"
  >
    {{submitting ? '提交中...' : '提交订单'}}
  </button>
</view>
