<!--pages/cart/cart.wxml-->
<view class="container">
  <view wx:if="{{cart.length > 0}}">
    <!-- 购物车列表 -->
    <scroll-view class="cart-list" scroll-y>
      <view wx:for="{{cart}}" wx:key="_id" class="cart-item">
        <image class="item-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-price">
            <text class="price-symbol">¥</text>
            <text>{{item.price}}</text>
          </view>
        </view>
        <view class="item-actions">
          <view class="quantity-control">
            <view class="btn-minus" bindtap="onRemove" data-id="{{item._id}}">
              <text>-</text>
            </view>
            <text class="quantity">{{item.quantity}}</text>
            <view class="btn-plus" bindtap="onAdd" data-id="{{item._id}}">
              <text>+</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="cart-footer">
      <view class="footer-info">
        <view class="total-label">总计：</view>
        <view class="total-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{totalPrice}}</text>
        </view>
      </view>
      <view class="footer-actions">
        <button class="btn-clear" bindtap="onClear">清空</button>
        <button class="btn-checkout btn-primary" bindtap="onCheckout">去结算</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-text">购物车是空的</text>
    <button class="btn-primary mt-30" bindtap="onGoBack">去点餐</button>
  </view>
</view>
