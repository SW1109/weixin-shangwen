<!--pages/dish-detail/dish-detail.wxml-->
<view class="container">
  <!-- 菜品图片 -->
  <view class="dish-image">
    <image src="{{dish.image}}" mode="widthFix" />
  </view>

  <!-- 菜品信息 -->
  <view class="dish-info">
    <view class="dish-header">
      <view class="dish-name">{{dish.name}}</view>
      <view class="dish-tags">
        <text class="tag" wx:if="{{dish.isHot}}">热销</text>
        <text class="tag" wx:if="{{dish.isNew}}">新品</text>
      </view>
    </view>
    
    <view class="dish-desc">{{dish.description}}</view>
    
    <view class="dish-price-stock">
      <view class="price">
        <text class="currency">¥</text>
        <text class="amount">{{dish.price}}</text>
        <text class="unit" wx:if="{{dish.unit}}">/ {{dish.unit}}</text>
      </view>
      <view class="stock">库存: {{dish.stock}}</view>
    </view>
  </view>

  <!-- 菜品详情 -->
  <view class="detail-section">
    <view class="section-title">菜品详情</view>
    <view class="detail-content">
      <view class="detail-item">
        <text class="label">分类:</text>
        <text class="value">{{dish.categoryName}}</text>
      </view>
      <view class="detail-item" wx:if="{{dish.ingredients}}">
        <text class="label">食材:</text>
        <text class="value">{{dish.ingredients}}</text>
      </view>
      <view class="detail-item" wx:if="{{dish.nutrition}}">
        <text class="label">营养:</text>
        <text class="value">{{dish.nutrition}}</text>
      </view>
      <view class="detail-item" wx:if="{{dish.allergen}}">
        <text class="label">过敏原:</text>
        <text class="value warning">{{dish.allergen}}</text>
      </view>
    </view>
  </view>

  <!-- 销量和评价 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">{{dish.salesCount || 0}}</text>
      <text class="stat-label">月销量</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{dish.rating || '5.0'}}</text>
      <text class="stat-label">评分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{dish.reviewCount || 0}}</text>
      <text class="stat-label">评价</text>
    </view>
  </view>

  <!-- 占位空间，避免被底部按钮遮挡 -->
  <view style="height: 120rpx;"></view>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="cart-wrapper" bindtap="goToCart">
    <image src="/images/tabbar/home.png" class="cart-icon" />
    <text class="cart-count" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
  </view>
  
  <view class="quantity-control">
    <view class="btn-minus {{quantity <= 1 ? 'disabled' : ''}}" bindtap="decreaseQuantity">
      <text>-</text>
    </view>
    <input type="number" class="quantity-input" value="{{quantity}}" disabled />
    <view class="btn-plus" bindtap="increaseQuantity">
      <text>+</text>
    </view>
  </view>
  
  <button class="btn-add-cart" bindtap="addToCart" disabled="{{!dish.stock || dish.stock <= 0}}">
    {{!dish.stock || dish.stock <= 0 ? '已售罄' : '加入购物车'}}
  </button>
</view>
