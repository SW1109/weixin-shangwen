<!--pages/order-detail/order-detail.wxml-->
<view class="container" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-card">
    <view class="status-header">
      <text class="status-text" style="color: {{order.status === 1 ? '#ff9800' : (order.status === 2 ? '#2196f3' : (order.status === 3 ? '#FF6B35' : (order.status === 4 ? '#bc0bf6' : '#999')))}}">{{order.status === 1 ? '待支付' : (order.status === 2 ? '待配送' : (order.status === 3 ? '配送中' : (order.status === 4 ? '已完成' : '已取消')))}}</text>
      <text class="status-desc" wx:if="{{order.status === 1}}">请尽快支付，超时将自动取消</text>
      <text class="status-desc" wx:elif="{{order.status === 2}}">商家已接单，正在准备中</text>
      <text class="status-desc" wx:elif="{{order.status === 3}}">骑手正在火速配送中</text>
      <text class="status-desc" wx:elif="{{order.status === 4}}">订单已完成，欢迎再次光临</text>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="section address-section">
    <view class="section-title">配送信息</view>
    <view class="address-info">
      <view class="info-row">
        <text class="label">收货人</text>
        <text class="value">{{order.address.name}} {{order.address.phone}}</text>
      </view>
      <view class="info-row">
        <text class="label">收货地址</text>
        <text class="value">{{order.address.fullAddress}}</text>
      </view>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="section dishes-section">
    <view class="section-title">菜品详情</view>
    <view class="dish-list">
      <view class="dish-item" wx:for="{{order.dishes}}" wx:key="dishId">
        <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <view class="dish-bottom">
            <text class="dish-price">¥{{item.price}}</text>
            <text class="dish-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="order-total">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section info-section">
    <view class="section-title">订单信息</view>
    <view class="info-list">
      <view class="info-row">
        <text class="label">订单编号</text>
        <text class="value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="label">下单时间</text>
        <text class="value">{{order.createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.payTime}}">
        <text class="label">支付时间</text>
        <text class="value">{{order.payTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="label">备注信息</text>
        <text class="value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{order.status === 1 || order.status === 2 || order.status === 3}}">
    <button class="btn-action" bindtap="onContact">联系商家</button>
    <button class="btn-action" wx:if="{{order.status === 1}}" bindtap="onCancel">取消订单</button>
    <button class="btn-action btn-primary" wx:if="{{order.status === 1}}" bindtap="onPay">立即支付</button>
  </view>
</view>
