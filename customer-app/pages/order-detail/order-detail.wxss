/* pages/order-detail/order-detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #bc0bf6 0%, #d65eff 100%);
  padding: 40rpx 30rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.status-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff !important; /* 强制覆盖内联样式 */
}

.status-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 通用板块样式 */
.section {
  background-color: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #bc0bf6;
  padding-left: 16rpx;
  line-height: 1;
}

/* 配送信息 */
.address-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.5;
}

.label {
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.value {
  color: #333;
  flex: 1;
  text-align: right;
}

/* 菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.dish-item {
  display: flex;
  align-items: center;
}

.dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  margin-right: 20rpx;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100rpx;
  padding: 4rpx 0;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.dish-price {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.dish-quantity {
  font-size: 26rpx;
  color: #999;
}

.order-total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 28rpx;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  color: #bc0bf6;
  font-weight: bold;
}

/* 订单信息 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.btn-action {
  margin: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  background-color: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.btn-action::after {
  border: none;
}

.btn-primary {
  background-color: #bc0bf6;
  color: #fff;
  border: none;
}
